# Copy to .env and adjust as needed.

# Where TimescaleDB's and Grafana's actual data files live on the host, as
# real bind-mounted directories rather than opaque named Docker volumes --
# see docs/NAS.md for why this matters for backups. Defaults to ./data next
# to this file, which is fine for a plain `docker compose up`. Deploying on
# a NAS/Portainer? Set this to an absolute path on a real local filesystem
# (not an SMB/CIFS share -- see docs/NAS.md), e.g.:
#   CURB_DATA_DIR=/volume1/docker/curb-selfhosted/data
CURB_DATA_DIR=./data

# Postgres/Timescale
POSTGRES_DB=curb
POSTGRES_USER=curb
POSTGRES_PASSWORD=change-me
# Password for the restricted `circuit_portal` DB role used by the
# config-portal service -- that role can only read circuit_config and flip
# its invert_display column, nothing else (see db/init/002_circuit_config.sh).
PORTAL_DB_PASSWORD=change-me

# Receiver
CURB_RECEIVER_PORT=8080
# Set to "true" to reject samples whose CRC32 trailer doesn't match (off by
# default -- it's a data-integrity nicety, not real security, since the
# format has no per-device signing).
CURB_VERIFY_CRC=false

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# Config portal (flip a circuit's invert_display flag -- see docs/NAS.md)
CURB_CONFIG_PORTAL_PORT=8082
